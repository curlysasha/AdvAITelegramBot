# Railway deployment environment variables for AdvAITelegramBot2
# Укажите свои значения в Railway Dashboard или .env.production

# Telegram Bot
API_ID=
API_HASH=
BOT_TOKEN=

# Администраторы (через запятую)
ADMINS=
OWNER_ID=

# Лог-канал (username или id)
LOG_CHANNEL=

# MongoDB
DATABASE_URL=

# Bing, OCR и другие ключи (если используются)
BING_COOKIE=
OCR_KEY=

# Имя бота (опционально)
BOT_NAME=AdvAITelegramBot2

# Для Railway: эти переменные будут автоматически подхвачены из Railway Dashboard
# Не храните секреты в публичных репозиториях!
